<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2">

    <!-- Header Section (Shifted up to remove status bar area) -->
    <ImageView
        android:id="@+id/logoCard"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="19dp"
        android:src="@drawable/e7d623b1_4e86_4658_873a_dab9cc82653b"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Botadex Logo" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="107dp"
        android:layout_marginTop="17dp"
        android:fontFamily="@font/cal_sans"
        android:text="Botadex"
        android:textColor="#1F4D2E"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="108dp"
        android:layout_marginTop="55dp"
        android:fontFamily="@font/cormorant_sc_bold"
        android:text="Root Crop Companion"
        android:textColor="#1D4D2E"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/headerDescription"
        android:layout_width="322dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="86dp"
        android:fontFamily="@font/eb_garamond"
        android:text="Your smart farming assistance for identifying and growing healthy root crops"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Swipeable Feature Cards -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpFeatures"
        android:layout_width="match_parent"
        android:layout_height="214dp"
        android:layout_marginTop="165dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pagination Dots -->
    <LinearLayout
        android:id="@+id/llPagination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vpFeatures">
        <!-- Dots will be added dynamically in HomeActivity -->
    </LinearLayout>

    <!-- My Crops Header -->
    <TextView
        android:id="@+id/tvMyCropsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="31dp"
        android:layout_marginTop="25dp"
        android:fontFamily="@font/instrument_sans"
        android:text="My Crops"
        android:textColor="#1F4D2E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llPagination" />

    <TextView
        android:id="@+id/btnViewAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="31dp"
        android:fontFamily="@font/instrument_sans"
        android:text="View All"
        android:textColor="#2E7D4A"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/tvMyCropsLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvMyCropsLabel" />

    <!-- My Crops List -->
    <ScrollView
        android:id="@+id/cropsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="63dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMyCropsLabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyCrops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/filterTabsContainer"
                tools:layout_editor_absoluteX="16dp"
                tools:listitem="@layout/item_my_crop" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar Area -->
    <View
        android:id="@+id/bottomNavBg"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="#4DD9D9D9"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="36dp"
                android:src="@drawable/home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Home"
                android:textColor="#2E7D4A"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/libr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Library"
                android:textColor="#5B6B7D"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Placeholder for center FAB -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/jour" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Journal"
                android:textColor="#5B6B7D"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="36dp"
                android:src="@drawable/calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Calendar"
                android:textColor="#5B6B7D"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Camera Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navIdentify"
        android:layout_width="74dp"
        android:layout_height="73dp"
        android:layout_marginBottom="15dp"
        app:cardBackgroundColor="#2E7D4A"
        app:cardCornerRadius="37dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:src="@drawable/cam" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>