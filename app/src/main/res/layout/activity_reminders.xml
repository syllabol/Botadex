<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2"
    tools:context=".RemindersActivity">

    <!-- Header Section -->

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/abc_ic_ab_back_material"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1D1B20"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/calendarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/instrument_sans"
        android:text="@string/title_calendar"
        android:textColor="#1F4D2E"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBg"
        app:layout_constraintTop_toBottomOf="@id/calendarTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Month Navigation -->
            <LinearLayout
                android:id="@+id/monthNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/prevMonth"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/abc_ic_ab_back_material"
                    app:tint="#1D1B20"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/monthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="11dp"
                    android:fontFamily="@font/instrument_sans"
                    android:textColor="#1F4D2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="July 2026" />

                <ImageView
                    android:id="@+id/nextMonth"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:rotation="180"
                    android:src="@drawable/abc_ic_ab_back_material"
                    app:tint="#1D1B20"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <!-- Calendar Grid -->
            <TableLayout
                android:id="@+id/calendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="14dp"
                android:stretchColumns="*"
                app:layout_constraintTop_toBottomOf="@id/monthNav">

                <TableRow>
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/sun" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/mon" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/tue" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/wed" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/thu" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/fri" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                    <TextView android:fontFamily="@font/instrument_sans" android:gravity="center" android:text="@string/sat" android:textColor="#000000" android:textSize="10sp" android:textStyle="bold" tools:ignore="SmallSp" />
                </TableRow>
            </TableLayout>

            <!-- Reminders Section -->
            <LinearLayout
                android:id="@+id/todayRemindersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/calendarGrid">

                <TextView
                    android:id="@+id/todayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:fontFamily="@font/instrument_sans"
                    android:text="@string/reminders_for_today"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/todayRemindersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#267BAF6F"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/todayRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_reminder_card" />

                        <TextView
                            android:id="@+id/noTodayRemindersText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/instrument_sans"
                            android:text="@string/no_reminders_day"
                            android:textColor="#5B6B7D"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Upcoming Reminders Section -->
            <LinearLayout
                android:id="@+id/upcomingRemindersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/todayRemindersSection">

                <TextView
                    android:id="@+id/upcomingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:fontFamily="@font/instrument_sans"
                    android:text="@string/upcoming"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/upcomingRemindersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#267BAF6F"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/upcomingRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_reminder_card" />

                        <TextView
                            android:id="@+id/noUpcomingRemindersText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/instrument_sans"
                            android:text="@string/no_upcoming_reminders"
                            android:textColor="#5B6B7D"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Area -->
    <View
        android:id="@+id/bottomNavBg"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="#4DD9D9D9"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavItems"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="36dp"
                android:src="@drawable/home__1_"
                app:tint="#5B6B7D"
                tools:ignore="ContentDescription" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#5B6B7D"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/libr"
                app:tint="#5B6B7D"
                tools:ignore="ContentDescription" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_library"
                android:textColor="#5B6B7D"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/jour"
                app:tint="#5B6B7D"
                tools:ignore="ContentDescription" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_journal"
                android:textColor="#5B6B7D"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="36dp"
                android:src="@drawable/calendar__1_"
                tools:ignore="ContentDescription" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_calendar"
                android:textColor="#2E7D4A"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/navIdentify"
        android:layout_width="74dp"
        android:layout_height="73dp"
        android:layout_marginBottom="15dp"
        app:cardBackgroundColor="#2E7D4A"
        app:cardCornerRadius="37dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:src="@drawable/cam" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
