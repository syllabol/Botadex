<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2">

    <!-- Header (Always on Top) -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:contentDescription="Back"
        android:src="@drawable/abc_ic_ab_back_material"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1D1B20" />

    <TextView
        android:id="@+id/tvIdentifyTitleHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/instrument_sans"
        android:text="Identify Crop"
        android:textColor="#1F4D2E"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Identify State Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/identifyLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBg"
        app:layout_constraintTop_toBottomOf="@id/tvIdentifyTitleHeader">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="262dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="39dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/eb_garamond"
            android:lineSpacingExtra="5dp"
            android:text="Take or upload photos of their leaves"
            android:textColor="#000000"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/initialImageCard"
            android:layout_width="325dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#D9D9D9"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tipsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/viewFinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scaleType="fillCenter" />

                <ImageView
                    android:id="@+id/imageViewInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Captured Image Preview"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Capture Controls -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/captureButton"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="23dp"
                    app:cardBackgroundColor="#2E7D4A"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:src="@drawable/cam" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/importButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="52dp"
                    android:layout_marginBottom="38dp"
                    app:cardBackgroundColor="#F4F6F2"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/gallery" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnFlash"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="52dp"
                    android:layout_marginBottom="38dp"
                    app:cardBackgroundColor="#F4F6F2"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/flash" />
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tips Card - Only in Identify state -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tipsCard"
            android:layout_width="325dp"
            android:layout_height="110dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#337BAF6F"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="53dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans"
                    android:lineSpacingExtra="15dp"
                    android:text="Use good lighting\nShow the whole leaf\nTake a clear image"
                    android:textColor="#B3000000"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Result State Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBg"
        app:layout_constraintTop_toBottomOf="@id/tvIdentifyTitleHeader">

        <!-- Fixed Header Part -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fixedResultHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvResultHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/eb_garamond"
                android:text="Result:"
                android:textColor="#000000"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/resultImageCard"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#D9D9D9"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvResultHeader">

                <ImageView
                    android:id="@+id/imageViewResult"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Result Image"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/cropNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/instrument_sans"
                android:textColor="#1F4D2E"
                android:textSize="28sp"
                android:textStyle="bold|italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/resultImageCard"
                app:layout_constraintTop_toTopOf="@id/resultImageCard"
                tools:text="*Plant Name*" />

            <TextView
                android:id="@+id/scientificNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans"
                android:textColor="#5B6B7D"
                android:textSize="14sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/cropNameText"
                app:layout_constraintTop_toBottomOf="@id/cropNameText"
                tools:text="Scientific Name" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/instrument_sans"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cropNameText"
                app:layout_constraintTop_toBottomOf="@id/scientificNameText"
                tools:text="100%" />

            <TextView
                android:id="@+id/healthStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_growing"
                android:fontFamily="@font/instrument_sans"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="6dp"
                android:text="Healthy"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/cropNameText"
                app:layout_constraintTop_toBottomOf="@id/confidenceText" />

            <TextView
                android:id="@+id/diseaseNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/instrument_sans"
                android:text="disease name"
                android:textColor="#5B6B7D"
                android:textSize="18sp"
                android:textStyle="italic"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/cropNameText"
                app:layout_constraintTop_toBottomOf="@id/healthStatusText" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Static Action Buttons Container (Fixed at Bottom) -->
        <LinearLayout
            android:id="@+id/actionButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/addToJournalButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/rounded_gray_button"
                android:backgroundTint="#2E7C49"
                android:fontFamily="@font/instrument_sans"
                android:text="Add to Journal"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tryAgainButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_gray_button"
                android:fontFamily="@font/instrument_sans"
                android:text="Try Again"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/importButtonResult"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_gray_button"
                android:fontFamily="@font/instrument_sans"
                android:text="Upload Photo"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/actionButtonsContainer"
            app:layout_constraintTop_toBottomOf="@id/fixedResultHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingBottom="16dp">

                <!-- Disease Info Section -->
                <LinearLayout
                    android:id="@+id/diseaseInfoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/eb_garamond"
                        android:text="About the Disease"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/diseaseDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/instrument_sans"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#444444"
                        android:textSize="15sp"
                        tools:text="Disease description goes here." />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/eb_garamond"
                        android:text="What to do"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/diseaseTreatmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/instrument_sans"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#444444"
                        android:textSize="15sp"
                        tools:text="Treatment steps go here." />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescriptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/eb_garamond"
                    android:text="Description"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/diseaseInfoLayout" />

                <TextView
                    android:id="@+id/descriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/instrument_sans"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/tvDescriptionLabel"
                    tools:text="Plant description goes here." />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Navigation Bar Bg -->
    <View
        android:id="@+id/bottomNavBg"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="#4DD9D9D9"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Navigation Area Icons & Labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/home__1_" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="#5B6B7D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/libr" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library"
                android:textSize="10sp"
                android:textColor="#5B6B7D" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/jour" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal"
                android:textSize="10sp"
                android:textColor="#5B6B7D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="10sp"
                android:textColor="#5B6B7D" />
        </LinearLayout>
    </LinearLayout>

    <!-- Camera FAB -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navIdentify"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginBottom="15dp"
        app:cardBackgroundColor="#2E7D4A"
        app:cardCornerRadius="37dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:src="@drawable/cam"
            android:contentDescription="Identify" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
