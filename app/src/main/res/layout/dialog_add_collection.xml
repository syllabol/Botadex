<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="New Crop Collection"
        android:textColor="@color/text_green_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editCollectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Plant Name (e.g. My Favorite Onion)"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/editCropName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Crop Type (e.g. Onion)"
        android:inputType="textCapWords" />

</LinearLayout>