                    android:layout_centerVertical="true"
                    android:fontFamily="@font/bakbak_one"
                    android:text="Fertilization"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/fertilizationArrow"
